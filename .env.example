# Supabase Edge Function secrets (set with `supabase secrets set`, never expose with VITE_).
# Free self-hosted LibreTranslate instance. Example: https://translate.example.com
TRANSLATION_API_URL=
# Optional; leave empty when the self-hosted instance does not require a key.
TRANSLATION_API_KEY=

# GitHub Pages browser configuration. The publishable key is designed to be public;
# database access is protected by the RLS policies in supabase/migrations.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
